# MongoDB connection string (local example shown)
MONGO_URI=mongodb://127.0.0.1:27017/multilingual-telemedicine
PORT=5000
CLIENT_URL=http://localhost:5173

# Required in Phase 2, when JWT authentication is added
JWT_SECRET=replace-with-a-long-random-secret

# Optional future translation provider key; never put this in frontend code
TRANSLATION_API_KEY=
